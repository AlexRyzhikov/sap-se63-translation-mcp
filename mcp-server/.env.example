# Easiest: run `npm run setup` – it writes this file for you.
# Manual: copy to .env (same folder as package.json) and fill in.
SAP_URL=https://my-sap-host:44300
SAP_CLIENT=100
SAP_USER=
# Password: NOT here. macOS: stored in the keychain by `npm run setup`, or manually:
#   security add-generic-password -s sap-se63-mcp -a <SAP_USER> -w
# Other OS / password managers: a command that prints the password, e.g.
# SAP_PASSWORD_CMD=op read op://Private/SAP/password
# SAP_KEYCHAIN_SERVICE=sap-se63-mcp
# Logon language for SAP messages (does not influence source/target language)
SAP_LANGUAGE=EN
# ICF path of ZCL_MCP_TRANSL_HTTP
SAP_SERVICE_PATH=/sap/bc/zmcp_transl
# Only for local/test systems with self-signed certificates. Better: NODE_EXTRA_CA_CERTS=/path/to/company-ca.pem
SAP_ALLOW_SELF_SIGNED=false
# Where worklists (JSON + CSV) are stored
WORKLIST_DIR=~/sap-translation-worklists
