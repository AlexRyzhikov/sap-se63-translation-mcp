# Easiest: run `npm run setup` – it writes this file for you.
# Manual: copy to .env (same folder as package.json) and fill in.
SAP_URL=https://my-sap-host:44300
SAP_CLIENT=100
SAP_USER=
# Password: NOT here. macOS: stored in the keychain by `npm run setup`, or manually:
#   security add-generic-password -s sap-se63-mcp -a <SAP_USER> -w
# Windows (DPAPI, no extra software; `npm run setup` writes this line and tells you the
# -Store command). Needs PowerShell 7 – 5.1 cannot do it under AppLocker:
# SAP_PASSWORD_CMD=pwsh -NoProfile -ExecutionPolicy Bypass -File "C:\path\to\mcp-server\scripts\windows-password.ps1"
# Other OS / password managers: any command that prints the password, e.g.
# SAP_PASSWORD_CMD=op read op://Private/SAP/password
# SAP_KEYCHAIN_SERVICE=sap-se63-mcp
# Logon language for SAP messages (does not influence source/target language)
SAP_LANGUAGE=EN
# ICF path of ZCL_MCP_TRANSL_HTTP
SAP_SERVICE_PATH=/sap/bc/zmcp_transl
# Company CA: Node ignores the OS certificate store, so a system your browser trusts still
# fails here. Best: NODE_OPTIONS=--use-system-ca (Node >= 22.15; setup puts it in the Claude
# Desktop entry on Windows). Or NODE_EXTRA_CA_CERTS=/path/to/company-ca.pem – a PEM *file*,
# a directory is ignored. The switch below only for local/test systems: it turns checking off.
SAP_ALLOW_SELF_SIGNED=false
# Where worklists (JSON + CSV) are stored
WORKLIST_DIR=~/sap-translation-worklists
